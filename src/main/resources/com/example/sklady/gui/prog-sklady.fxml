<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.example.sklady.gui.ProgSkladyController">
  <padding>
    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
  </padding>

  <HBox spacing="10.0" alignment="CENTER_LEFT">
    <Button text="📂 Načíst CSV" onAction="#onLoadDataClick" style="-fx-cursor: hand;" />
    <TextField fx:id="txtPocetGeneruj" text="20" promptText="Počet" prefWidth="60.0" />
    <Button text="Generuj" onAction="#onGenerujClick" style="-fx-cursor: hand;" />
    <Button text="💾 Uložit do souboru" onAction="#onSaveClick" style="-fx-cursor: hand;" />
    <Separator orientation="VERTICAL" />
    <Label text="Sklad:" />
    <ComboBox fx:id="comboSklady" prefWidth="120.0" onAction="#onSkladSelected" />
    <Button text="Zobrazit vše" onAction="#onShowAllClick" style="-fx-cursor: hand;" />
    <Separator orientation="VERTICAL" />
    <Button text="➕ Vložit" onAction="#onAddProductClick" style="-fx-cursor: hand;" />
    <Button text="❌ Odebrat" onAction="#onRemoveProductClick" style="-fx-cursor: hand;" />
    <Button text="➡ Přesunout" fx:id="btnMove" onAction="#onMoveProductClick" disable="true" style="-fx-cursor: hand;" />
    <Button text="✖ Zrušit" onAction="#onClearClick" style="-fx-cursor: hand;" />
  </HBox>

  <HBox spacing="10.0" alignment="CENTER_LEFT">
    <Button text="📊 Průměrná cena" onAction="#onAveragePriceClick" style="-fx-cursor: hand;" />
    <Label fx:id="lblAveragePrice" text="Cena: -" style="-fx-font-weight: bold;" />
    <TextField fx:id="txtLimit" promptText="Limit množství" prefWidth="110.0" />
    <Button text="Filtrovat" onAction="#onFilterLimitClick" style="-fx-cursor: hand;" />
    <Separator orientation="VERTICAL" />
    <Button text="⏮ První" onAction="#onFirstClick" style="-fx-cursor: hand;" />
    <Button text="◀ Předchozí" onAction="#onPreviousClick" style="-fx-cursor: hand;" />
    <Button text="▶ Následník" onAction="#onNextClick" style="-fx-cursor: hand;" />
    <Button text="⏭ Poslední" onAction="#onLastClick" style="-fx-cursor: hand;" />
  </HBox>

  <HBox spacing="10.0" alignment="CENTER_LEFT">
    <Label text="ID:" />
    <TextField fx:id="txtHledaneId" promptText="P001" prefWidth="80.0" onAction="#onNajdiClick" />
    <Button text="🔍 Najdi" onAction="#onNajdiClick" style="-fx-cursor: hand;" />
    <Separator orientation="VERTICAL" />
    <Label text="Rozsah od:" />
    <TextField fx:id="txtIdOd" promptText="P010" prefWidth="80.0" />
    <Label text="do:" />
    <TextField fx:id="txtIdDo" promptText="P020" prefWidth="80.0" onAction="#onNajdiVRozsahuClick" />
    <Button text="Najdi v rozsahu" onAction="#onNajdiVRozsahuClick" style="-fx-cursor: hand;" />
    <Separator orientation="VERTICAL" />
    <Button text="Strom do hloubky" onAction="#onHloubkaClick" style="-fx-cursor: hand;" />
    <Button text="Strom do šířky" onAction="#onSirkaClick" style="-fx-cursor: hand;" />
    <Button text="Vybuduj" onAction="#onVybudujClick" style="-fx-cursor: hand;" />
    <Button text="Zobrazit strom" onAction="#onZobrazStromClick" style="-fx-cursor: hand;" />
  </HBox>

  <Label fx:id="lblDetail" text="Produkt: -" />

  <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS" prefWidth="750.0">
    <columns>
      <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
      <TableColumn fx:id="colName" prefWidth="200.0" text="Název" />
      <TableColumn fx:id="colCategory" prefWidth="160.0" text="Kategorie" />
      <TableColumn fx:id="colPrice" prefWidth="100.0" text="Cena" />
      <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Množství" />
      <TableColumn fx:id="colSklad" prefWidth="100.0" text="Sklad" />
    </columns>
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
  </TableView>

  <Label fx:id="lblStav" text="" />
</VBox>
